# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2

# Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
HTTPS_ONLY=false
TRUSTED_HOSTS=localhost,127.0.0.1

# Upload / input limits
MAX_UPLOAD_BYTES=10485760
MAX_JOB_DESCRIPTION_CHARS=10000

# Auth / database
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./data/talentpilot.db
SESSION_MAX_AGE_SECONDS=1209600

# Rate limits (per IP / minute)
RATE_LIMIT_ANALYZE_PER_MINUTE=10
RATE_LIMIT_AUTH_PER_MINUTE=20

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
